{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python .claude/hooks/post_edit_ruff.py",
            "timeout": 60,
            "statusMessage": "ruff: fixing and formatting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python .claude/hooks/stop_checks.py",
            "timeout": 180,
            "statusMessage": "mypy + pytest"
          }
        ]
      }
    ]
  }
}
